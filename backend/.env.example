# Backend environment variables example
VERONICA_GEMINI_API_KEY=your_gemini_api_key_here
VERONICA_GOOGLE_CLIENT_ID=your_google_client_id_here
VERONICA_GOOGLE_CLIENT_SECRET=your_google_client_secret_here
VERONICA_GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
VERONICA_TEMPLATE_PRESENTATION_ID=your_template_presentation_id_here
VERONICA_ENDWEEK_TEMPLATE_ID=your_endweek_template_id_here
VERONICA_TARGET_SPREADSHEET_ID=your_target_spreadsheet_id_here

GNS_GEMINI_API_KEY=your_gemini_api_key_here
GNS_GOOGLE_CLIENT_ID=your_google_client_id_here
GNS_GOOGLE_CLIENT_SECRET=your_google_client_secret_here
